# Upstream XPU installs headers/libraries, but no CMake package or xpu_attach.
# Discover that installation without rebuilding or copying its runtime.
function(kfparticle_find_installed_xpu found)
  if(NOT TARGET XPU::xpu)
    if(TARGET xpu)
      add_library(XPU::xpu ALIAS xpu)
    else()
      set(search_options "")
      if(KFPARTICLE_XPU_ROOT)
        set(search_options NO_DEFAULT_PATH)
      endif()
      find_path(_kfp_xpu_include xpu/host.h HINTS "${KFPARTICLE_XPU_ROOT}"
        PATH_SUFFIXES include ${search_options})
      find_library(_kfp_xpu_library NAMES xpu HINTS "${KFPARTICLE_XPU_ROOT}"
        PATH_SUFFIXES lib lib64 ${search_options})
      set(headers "${_kfp_xpu_include}")
      set(library "${_kfp_xpu_library}")
      unset(_kfp_xpu_include CACHE)
      unset(_kfp_xpu_library CACHE)
      if(NOT headers OR NOT library)
        set(${found} FALSE PARENT_SCOPE)
        return()
      endif()
      add_library(XPU::xpu SHARED IMPORTED GLOBAL)
      set_target_properties(XPU::xpu PROPERTIES
        IMPORTED_LOCATION "${library}" INTERFACE_INCLUDE_DIRECTORIES "${headers}")
    endif()
  endif()
  get_target_property(library XPU::xpu IMPORTED_LOCATION)
  get_filename_component(directory "${library}" DIRECTORY)
  set(KFPARTICLE_XPU_LIBRARY "${library}" PARENT_SCOPE)
  set(KFPARTICLE_XPU_LIBRARY_DIR "${directory}" PARENT_SCOPE)
  set(${found} TRUE PARENT_SCOPE)
endfunction()

function(kfparticle_attach_installed_xpu library)
  target_compile_definitions(${library} PRIVATE XPU_IMAGE_FILE="${library}")
  set_property(TARGET ${library} PROPERTY POSITION_INDEPENDENT_CODE ON)
  target_link_libraries(${library} PUBLIC XPU::xpu)
  set_property(TARGET ${library} APPEND PROPERTY BUILD_RPATH "${KFPARTICLE_XPU_LIBRARY_DIR}")
  if(XPU_ENABLE_OPENMP)
    find_package(OpenMP REQUIRED COMPONENTS CXX)
    target_link_libraries(${library} PUBLIC OpenMP::OpenMP_CXX)
  endif()
  if(XPU_ENABLE_CUDA OR XPU_ENABLE_SYCL)
    message(FATAL_ERROR "Installed XPU integration currently supports HIP and CPU; use the source integration for other backends")
  endif()
  if(NOT XPU_ENABLE_HIP)
    return()
  endif()
  if(NOT EXISTS "${KFPARTICLE_XPU_LIBRARY_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}xpu_Hip${CMAKE_SHARED_LIBRARY_SUFFIX}")
    message(FATAL_ERROR "The selected XPU installation has no HIP backend: ${KFPARTICLE_XPU_LIBRARY_DIR}")
  endif()
  if(NOT EXISTS "${XPU_ROCM_ROOT}/llvm/bin/clang++")
    message(FATAL_ERROR "Set XPU_ROCM_ROOT to a ROCm installation with llvm/bin/clang++")
  endif()

  # Keep the upstream HIP compilation flags and separate host/device images.
  include(ExternalProject)
  set(image "${library}_Hip")
  set(source "${CMAKE_CURRENT_BINARY_DIR}/${image}-source")
  file(MAKE_DIRECTORY "${source}")
  set(unity "")
  foreach(path IN LISTS ARGN)
    get_filename_component(path "${path}" ABSOLUTE)
    string(APPEND unity "#include \"${path}\"\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  endforeach()
  file(CONFIGURE OUTPUT "${source}/kernels.cxx" CONTENT "@unity@" @ONLY)
  file(GENERATE OUTPUT "${source}/includes.cmake"
    CONTENT "include_directories(\"$<JOIN:$<TARGET_PROPERTY:${library},INCLUDE_DIRECTORIES>,\" \">\")\n")
  get_target_property(output ${library} LIBRARY_OUTPUT_DIRECTORY)
  file(CONFIGURE OUTPUT "${source}/CMakeLists.txt" CONTENT [=[
cmake_minimum_required(VERSION 3.18)
project(@image@ LANGUAGES CXX)
set(CMAKE_CXX_STANDARD @CMAKE_CXX_STANDARD@)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(GPU_TARGETS "@XPU_HIP_ARCH@")
list(APPEND CMAKE_PREFIX_PATH "@XPU_ROCM_ROOT@" "@XPU_ROCM_ROOT@/hip")
find_package(hip REQUIRED CONFIG)
find_package(rocprim REQUIRED CONFIG PATHS "@XPU_ROCM_ROOT@/rocprim")
find_package(hipcub REQUIRED CONFIG PATHS "@XPU_ROCM_ROOT@/hipcub")
include("${CMAKE_CURRENT_SOURCE_DIR}/includes.cmake")
add_library(@image@ MODULE kernels.cxx)
target_compile_options(@image@ PRIVATE -std=c++@CMAKE_CXX_STANDARD@ -Qunused-arguments)
if(@XPU_DEBUG@)
  target_compile_options(@image@ PRIVATE -Og -g3)
else()
  target_compile_options(@image@ PRIVATE -O3)
  target_compile_definitions(@image@ PRIVATE NDEBUG)
endif()
target_link_libraries(@image@ PRIVATE hip::device hip::hipcub)
]=] @ONLY)
  ExternalProject_Add(${image}
    SOURCE_DIR "${source}" BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}/${image}-build"
    CMAKE_ARGS "-DCMAKE_CXX_COMPILER=${XPU_ROCM_ROOT}/llvm/bin/clang++"
      "-DCMAKE_LIBRARY_OUTPUT_DIRECTORY=${output}"
    BUILD_ALWAYS TRUE INSTALL_COMMAND "" EXCLUDE_FROM_ALL TRUE
    LOG_CONFIGURE TRUE LOG_BUILD TRUE LOG_OUTPUT_ON_FAILURE TRUE
    BUILD_BYPRODUCTS "${output}/${CMAKE_SHARED_LIBRARY_PREFIX}${image}${CMAKE_SHARED_LIBRARY_SUFFIX}")
  add_dependencies(${library} ${image})
  install(FILES "${output}/${CMAKE_SHARED_LIBRARY_PREFIX}${image}${CMAKE_SHARED_LIBRARY_SUFFIX}"
    DESTINATION "${CMAKE_INSTALL_LIBDIR}")
endfunction()

function(kfparticle_configure_xpu)
  if(TARGET xpu)
    set(owns OFF)
    if(KFPARTICLE_INSTALL_SDK)
      message(FATAL_ERROR "Build the standalone SDK separately from a parent-owned XPU target")
    endif()
    message(STATUS "KFParticle: reusing application-owned XPU")
  elseif(KFPARTICLE_XPU_ROOT OR NOT (KFPARTICLE_XPU_SOURCE_DIR OR XPU_SOURCE_DIR))
    kfparticle_find_installed_xpu(found)
    if(NOT found)
      message(FATAL_ERROR "XPU headers/library not found; set KFPARTICLE_XPU_ROOT to the installed XPU prefix")
    endif()
    add_library(xpu ALIAS XPU::xpu)
    set(owns OFF)
    set(XPU_ENABLE_HIP OFF CACHE BOOL "Build KFParticle HIP kernels")
    set(XPU_DEBUG OFF CACHE BOOL "Build GPU images with debug information")
    if(APPLE)
      set(XPU_ENABLE_OPENMP OFF CACHE BOOL "Use OpenMP for CPU-XPU kernels")
    else()
      set(XPU_ENABLE_OPENMP ON CACHE BOOL "Use OpenMP for CPU-XPU kernels")
    endif()
    set(XPU_HIP_ARCH "gfx906;gfx908" CACHE STRING "HIP target architectures")
    set(XPU_ROCM_ROOT /opt/rocm CACHE PATH "ROCm installation")
    function(xpu_attach library)
      kfparticle_attach_installed_xpu(${library} ${ARGN})
    endfunction()
    message(STATUS "KFParticle: using installed XPU ${KFPARTICLE_XPU_LIBRARY}")
  else()
    # Source-tree development remains available; no download, patch or pin.
    if(NOT KFPARTICLE_XPU_SOURCE_DIR)
      set(KFPARTICLE_XPU_SOURCE_DIR "${XPU_SOURCE_DIR}")
    endif()
    get_filename_component(KFPARTICLE_XPU_SOURCE_DIR "${KFPARTICLE_XPU_SOURCE_DIR}" ABSOLUTE)
    if(NOT EXISTS "${KFPARTICLE_XPU_SOURCE_DIR}/src/xpu/host.h")
      message(FATAL_ERROR "Invalid XPU source directory: ${KFPARTICLE_XPU_SOURCE_DIR}")
    endif()
    set(owns ON)
    if(KFPARTICLE_INSTALL_SDK)
      add_subdirectory("${KFPARTICLE_XPU_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/xpu" EXCLUDE_FROM_ALL)
    else()
      add_subdirectory("${KFPARTICLE_XPU_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/xpu")
    endif()
  endif()
  get_target_property(includes xpu INTERFACE_INCLUDE_DIRECTORIES)
  set(KFPARTICLE_XPU_INCLUDE_DIRS "${includes}" PARENT_SCOPE)
  set(KFPARTICLE_OWNS_XPU "${owns}" PARENT_SCOPE)
  set(KFPARTICLE_XPU_SOURCE_DIR "${KFPARTICLE_XPU_SOURCE_DIR}" PARENT_SCOPE)
  set(KFPARTICLE_XPU_LIBRARY "${KFPARTICLE_XPU_LIBRARY}" PARENT_SCOPE)
  set(KFPARTICLE_XPU_LIBRARY_DIR "${KFPARTICLE_XPU_LIBRARY_DIR}" PARENT_SCOPE)
endfunction()
