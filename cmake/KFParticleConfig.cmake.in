@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(_KFParticle_package_prefix "${PACKAGE_PREFIX_DIR}")
find_dependency(ROOT CONFIG COMPONENTS Core Hist Matrix Physics EG Gpad Graf Graf3d RIO MathCore)
find_dependency(Vc CONFIG)
if(@KFPARTICLE_SDK_NEEDS_OPENMP@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()
set(PACKAGE_PREFIX_DIR "${_KFParticle_package_prefix}")
unset(_KFParticle_package_prefix)

if(@KFPARTICLE_SDK_EXTERNAL_XPU@)
  include("${CMAKE_CURRENT_LIST_DIR}/KFParticleXpu.cmake")
  kfparticle_find_installed_xpu(_KFParticle_xpu_found)
  if(NOT _KFParticle_xpu_found)
    set(KFParticle_FOUND FALSE)
    set(KFParticle_NOT_FOUND_MESSAGE "Set KFPARTICLE_XPU_ROOT to the installed XPU prefix")
    return()
  endif()
  set(KFParticle_XPU_LIBRARY_DIR "${KFPARTICLE_XPU_LIBRARY_DIR}")
else()
  set(KFParticle_XPU_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
endif()

set(KFParticle_VERSION "@KFPARTICLE_SDK_VERSION@")
set(KFParticle_SOURCE_SHA256 "@KFPARTICLE_SDK_SOURCE_SHA256@")
set(KFParticle_GPU_FOUND @KFPARTICLE_USE_XPU@)
set(KFParticle_HIP_FOUND @KFPARTICLE_SDK_HIP@)
set(KFParticle_FIXTARGET @FIXTARGET@)
set(KFParticle_HIP_ARCH "@XPU_HIP_ARCH@")
set_and_check(KFParticle_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
include("${CMAKE_CURRENT_LIST_DIR}/KFParticleTargets.cmake")

# XPU loads plugins by filename. Check them here rather than failing on first use.
foreach(plugin IN ITEMS @KFPARTICLE_SDK_PLUGINS@)
  if(NOT EXISTS "${KFParticle_LIBRARY_DIR}/${plugin}")
    set(KFParticle_FOUND FALSE)
    set(KFParticle_NOT_FOUND_MESSAGE "KFParticle SDK is incomplete: missing ${KFParticle_LIBRARY_DIR}/${plugin}")
    return()
  endif()
endforeach()
foreach(plugin IN ITEMS @KFPARTICLE_SDK_XPU_PLUGINS@)
  if(NOT EXISTS "${KFParticle_XPU_LIBRARY_DIR}/${plugin}")
    set(KFParticle_FOUND FALSE)
    set(KFParticle_NOT_FOUND_MESSAGE "The selected XPU installation is missing ${plugin}: ${KFParticle_XPU_LIBRARY_DIR}")
    return()
  endif()
endforeach()
check_required_components(KFParticle)
